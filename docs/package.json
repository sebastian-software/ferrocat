{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-site-data.mjs && ardo dev",
    "build": "node ../scripts/check-docs-links.mjs && node scripts/write-site-data.mjs && ardo build && node scripts/verify-build.mjs",
    "preview": "ardo preview",
    "check:links": "node ../scripts/check-docs-links.mjs",
    "lint": "node scripts/write-site-data.mjs && pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "node scripts/write-site-data.mjs && tsc --noEmit",
    "browser:check": "node scripts/check-browser.mjs",
    "sample:write": "node scripts/render-audit-sample.mjs && node scripts/render-home-samples.mjs",
    "sample:check": "node scripts/render-audit-sample.mjs --check && node scripts/render-home-samples.mjs --check",
    "verify": "pnpm sample:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm browser:check"
  },
  "dependencies": {
    "ardo": "^6.9.0",
    "ferramenta-family": "3.0.0"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-setup": "^0.5.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "1.65.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
